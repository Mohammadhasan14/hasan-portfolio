# Supabase — https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin session cookie signing — generate with: openssl rand -base64 32
SESSION_SECRET=

# Used only once, by `npm run seed:admin` — not read at app runtime.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudflare Turnstile (wired up in Phase 3)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend — optional email notifications (Phase 3)
RESEND_API_KEY=
