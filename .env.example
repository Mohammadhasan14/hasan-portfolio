# Supabase — https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Admin session cookie signing — generate with: openssl rand -base64 32
SESSION_SECRET=

# Used only once, by `npm run seed:admin` — not read at app runtime.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudflare Turnstile — spam protection on the public contact form
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend — optional email notification when a contact form is submitted.
# Leave both unset to skip; without a verified custom domain, Resend can
# only deliver to the email address that owns the account.
RESEND_API_KEY=
RESEND_NOTIFY_EMAIL=
